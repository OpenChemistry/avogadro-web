# Build trees (README uses build-*/ and stage-*/ at the top level)
/build/
/build-*/
/stage-*/
/install/
/out/

# In-source CMake leftovers
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
CMakeUserPresets.json
compile_commands.json

# Qt / Qt Creator
*_autogen/
moc_*.cpp
qrc_*.cpp
ui_*.h
*.qm
CMakeLists.txt.user*

# C++ objects and binaries
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.dSYM/

# Emscripten / Qt WASM output that escapes a build tree
*.wasm
*.wasm.gz
*.wasm.br
qtloader.js
/avogadro-web.js
/avogadro-web.html
/avogadro-offline.html

# Browser test evidence (default output dirs of tests/*.mjs)
/evidence/
browser-evidence/
firefox-evidence/

# Node (puppeteer-core); keep package-lock.json tracked
node_modules/
npm-debug.log*
.npm/

# Python (serve-wasm.py, tests/check-build-profile.py)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Tooling caches (clangd, pre-commit, etc.)
.cache/

# Editors and OS
.DS_Store
*.swp
*~
.idea/
